#!/bin/csh -f

setenv BCSDIR    {{ bcs_dir }}
{{ ocean.data }}setenv SSTDIR    {{ sst_dir }}
{{ ocean.coupled }}setenv CPLDIR {{ coupled_dir }}/{{ ocean.model }}
setenv CHMDIR    {{ chem_dir }}
setenv BCRSLV    {{ atmos.res }}_{{ ocean.res }}

{{ MOM5 }}setenv SSTDIR  {{ coupled_dir }}/SST/MERRA2/{{ ocean.IM }}x{{ ocean.JM }}/v1
{{ ocean.MOM6 }}setenv SSTDIR  {{ coupled_dir }}/SST/MERRA2/{{ ocean.IM }}x{{ ocean.JM }}/v1

{{ ocean.coupled }} /bin/mkdir -p RESTART
/bin/mkdir -p            ExtData
/bin/ln    -sf $CHMDIR/* ExtData

{{ ocean.coupled }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/SEAWIFS_KPAR_mon_clim.{{ ocean.IM }}x{{ ocean.JM }} SEAWIFS_KPAR_mon_clim.data
{{ ocean.coupled }}/bin/ln -sf $BCSDIR/geometry/${BCRSLV}/${BCRSLV}-Pfafstetter.til   tile.data
{{ ocean.coupled }}/bin/ln -sf $BCSDIR/geometry/${BCRSLV}/${BCRSLV}-Pfafstetter.TRN   runoff.bin
{{ MOM5 }}/bin/ln -sf $BCSDIR/geometry/${BCRSLV}/MAPL_Tripolar.nc .
{{ ocean.MOM6 }}/bin/ln -sf $BCSDIR/geometry/${BCRSLV}/MAPL_Tripolar.nc .
{{ ocean.MIT }}/bin/ln  -sf $BCSDIR/geometry/${BCRSLV}/mit.ascii
{{ MOM5 }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/vgrid{{ ocean.LM }}.ascii ./vgrid.ascii
{{ ocean.MOM6 }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/vgrid{{ ocean.LM }}.ascii ./vgrid.ascii
{{ ocean.MIT }}/bin/ln  -sf $CPLDIR/DC0360xPC0181_LL5400x15-LL.bin DC0360xPC0181_LL5400x15-LL.bin

# Precip correction
#/bin/ln -s /discover/nobackup/projects/gmao/share/gmao_ops/fvInput/merra_land/precip_CPCUexcludeAfrica-CMAP_corrected_MERRA/GEOSdas-2_1_4 ExtData/PCP

{{ ocean.data }}/bin/ln -sf $BCSDIR/geometry/$BCRSLV/${BCRSLV}-Pfafstetter.til  tile.data
{{ ocean.data }}if(     -e  $BCSDIR/geometry/$BCRSLV/${BCRSLV}-Pfafstetter.TIL) then
{{ ocean.data }}/bin/ln -sf $BCSDIR/geometry/$BCRSLV/${BCRSLV}-Pfafstetter.TIL  tile.bin
{{ ocean.data }}endif
if(     -e  $BCSDIR/geometry/$BCRSLV/${BCRSLV}-Pfafstetter.nc4) then
/bin/ln -sf $BCSDIR/geometry/$BCRSLV/${BCRSLV}-Pfafstetter.nc4  tile.nc4
endif

# DAS or REPLAY Mode (AGCM.rc:  pchem_clim_years = 1-Year Climatology)
# --------------------------------------------------------------------
{{ gocart.ops_species }}/bin/ln -sf $BCSDIR/PCHEM/pchem.species.Clim_Prod_Loss.z_721x72.nc4 species.data

# CMIP-5 Ozone Data (AGCM.rc:  pchem_clim_years = 228-Years)
# ----------------------------------------------------------
{{ gocart.cmip_species }}/bin/ln -sf $BCSDIR/PCHEM/pchem.species.CMIP-5.1870-2097.z_91x72.nc4 species.data

# S2S pre-industrial with prod/loss of stratospheric water vapor
# (AGCM.rc:  pchem_clim_years = 3-Years,  and  H2O_ProdLoss: 1 )
# --------------------------------------------------------------
#/bin/ln -sf $BCSDIR/Shared/pchem.species.CMIP-6.wH2OandPL.1850s.z_91x72.nc4 species.data

# MERRA-2 Ozone Data (AGCM.rc:  pchem_clim_years = 48-Years)
# ----------------------------------------------------------
{{ gocart.MERRA2OX_SPECIES }}/bin/ln -sf $BCSDIR/PCHEM/pchem.species.CMIP-5.MERRA2OX.197902-202608.z_91x72.nc4 species.data

/bin/ln -sf $BCSDIR/land/$BCRSLV/visdf_{{ atmos.im }}x{{ atmos.jm }}.dat visdf.dat
/bin/ln -sf $BCSDIR/land/$BCRSLV/nirdf_{{ atmos.im }}x{{ atmos.jm }}.dat nirdf.dat
/bin/ln -sf $BCSDIR/land/$BCRSLV/vegdyn_{{ atmos.im }}x{{ atmos.jm }}.dat vegdyn.data
/bin/ln -sf $BCSDIR/land/$BCRSLV/lai_clim_{{ atmos.im }}x{{ atmos.jm }}.data lai.data
/bin/ln -sf $BCSDIR/land/$BCRSLV/green_clim_{{ atmos.im }}x{{ atmos.jm }}.data green.data
/bin/ln -sf $BCSDIR/land/$BCRSLV/ndvi_clim_{{ atmos.im }}x{{ atmos.jm }}.data ndvi.data

{{ land.GCMRUN_catchment }}if ( -f $BCSDIR/$BCRSLV/lnfm_clim_{{ atmos.im }}x{{ atmos.jm }}.data  ) /bin/ln -sf $BCSDIR/land/$BCRSLV/lnfm_clim_{{ atmos.im }}x{{ atmos.jm }}.data lnfm.data
{{ land.GCMRUN_catchment }}/bin/ln -s $BCSDIR/land/shared/CO2_MonthlyMean_DiurnalCycle.nc4


set MERRA2OX_SPECIES = "#"

# ----- Topography linking ( GM4 | v1 | v2) -----

set bc_is_gm4 = 0
if ( "$BCSDIR" =~ */GM4* ) then
  set bc_is_gm4 = 1
endif
set bc_ver_num = `echo "$BCSDIR" | sed -n 's#.*\/v\([0-9][0-9]*\)[^/]*\(\/.*\|$\)#\1#p'`
if ( "$bc_ver_num" == "" ) set bc_ver_num = 0

if ( $bc_is_gm4 ) then
  # GM4 stays on legacy tiles layout
  set topo_src_dir = "$BCSDIR/TOPO/TOPO_{{ atmos.res }}"
else
  set stream = v1
  if ( $bc_ver_num >= 15 ) set stream = v2
  set topo_src_dir = "{{ bcs_input_base }}/TOPO/${stream}/{{ atmos.res }}/smoothed"
endif

set fn_dyn = topo_DYN_ave_{{ atmos.im }}x{{ atmos.jm }}.data
set fn_gwd = topo_GWD_var_{{ atmos.im }}x{{ atmos.jm }}.data
set fn_trb = topo_TRB_var_{{ atmos.im }}x{{ atmos.jm }}.data

if ( ! -e ${topo_src_dir}/${fn_dyn} ) then
  echo "FATAL: ${fn_dyn} not found in ${topo_src_dir}"
  exit 2
endif

/bin/ln -sf ${topo_src_dir}/${fn_dyn} topo_dynave.data
/bin/ln -sf ${topo_src_dir}/${fn_gwd} topo_gwdvar.data
/bin/ln -sf ${topo_src_dir}/${fn_trb} topo_trbvar.data

# Optional internal restart
if ( -e ${topo_src_dir}/gwd_internal_rst ) then
  /bin/cp -vf ${topo_src_dir}/gwd_internal_rst gwd_internal_rst
else if (-e {{ gwdrs_dir }}/gwd_internal_c{{ atmos.im }}) then
  /bin/cp -vf {{ gwdrs_dir }}/gwd_internal_c{{ atmos.im }} gwd_internal_rst
endif
# ----- end topo gwd linking -----

{{ ocean.coupled }}cp $HOMDIR/*_table .
{{ ocean.coupled }}cp $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/INPUT/* INPUT
{{ ocean.CICE4 }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/cice/kmt_cice.bin .
{{ ocean.CICE4 }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/cice/grid_cice.bin .
{{ ocean.CICE6 }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/cice6/cice6_grid.nc .
{{ ocean.CICE6 }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/cice6/cice6_kmt.nc .
{{ ocean.CICE6 }}/bin/ln -sf $CPLDIR/{{ ocean.IM }}x{{ ocean.JM }}/cice6/cice6_global.bathy.nc .


{{ ocean.data }}/bin/ln -sf $SSTDIR/{{ ocean.sst_file }}   sst.data
{{ ocean.data }}/bin/ln -sf $SSTDIR/{{ ocean.ice_file }} fraci.data
{{ ocean.data }}/bin/ln -sf $SSTDIR/{{ ocean.kpar_file }} SEAWIFS_KPAR_mon_clim.data
