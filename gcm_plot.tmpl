#!/bin/csh -f

#######################################################################
#                     Batch Parameters for Plot Job
#######################################################################

#{{ batch_time }}{{ plot_t }}
#{{ plot_p }}
#{{ batch_jobname }}@NAME
#{{ plot_q }}
#{{ batch_group_full }}
#{{ batch_outputname }}OUTPUT

#######################################################################
#                  System Environment Variables
#######################################################################

umask 022

limit stacksize unlimited

{{ mpi_config }}

{{ ocean.mpt_shepherd }}

#######################################################################
#           Architecture Specific Environment Variables
#######################################################################

setenv ARCH `uname`

setenv SITE             {{ site }}
setenv GEOSBIN          {{ bin_path }}
setenv GEOSUTIL         {{ install_path }}

source $GEOSBIN/g5_modules
setenv {{ ld_library_path_command }} ${LD_LIBRARY_PATH}
if ( $?BASEDIR ) then
    setenv {{ ld_library_path_command }} ${{'{'}}{{ ld_library_path_command }}{{'}'}}:${BASEDIR}/${ARCH}/lib
endif

#######################################################################
#             Experiment Specific Environment Variables
#######################################################################

setenv    EXPID   {{ expConfig.experiment_id }}
setenv    EXPDIR  {{ exp_dir }}
setenv    HOMDIR  {{ exp_dir }}

#######################################################################
#                         Quickplot Commands
#######################################################################

cd $EXPDIR/plot

if( $SITE == NCCS ) then
     srun ./gcm_quickplot.csh @N @LIST
else
          ./gcm_quickplot.csh @N @LIST
endif

#######################################################################
#                        Move Plots to Web Server
#######################################################################

 set MOVE =  `grep PLOT_MOVE: $EXPDIR/plot/plot.rc | cut -d'#' -f1 | cut -d':' -f2`
if( $MOVE[1] == 'ON' ) {{ batch_cmd }} $EXPDIR/plot/gcm_moveplot.j

